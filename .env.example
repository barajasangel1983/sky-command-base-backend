# Copy this file to .env and fill in your values.

# JWT signing secret — generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-64-char-hex-string

# Internal key used by Claude Code hooks to authenticate with the monitor endpoint
MONITOR_API_KEY=choose-a-strong-random-key

# Brave Search API  https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=

# xAI (Grok 4) — primary LLM for research jobs  https://console.x.ai/
XAI_API_KEY=

# LM Studio — local LLM fallback (optional)
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_API_KEY=lmstudio
LMSTUDIO_MODEL=local-model
